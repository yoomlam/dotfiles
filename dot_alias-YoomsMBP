alias coli='colima -p ${COLIMA_VM:=vz}'
colima_vz(){
  colima list
  if ! coli status; then
    if ! coli start; then
      echo "Could not start colima!"
      return 400
    fi
  fi

  export COLIMA_VM_SOCKET="${HOME}/.colima/${COLIMA_VM}/docker.sock"
  # export DOCKER_HOST="unix://${COLIMA_VM_SOCKET}"
  # https://github.com/abiosoft/colima/discussions/609#discussioncomment-4892088:
  # You can have the DOCKER_HOST environment set for the current shell, it takes precedence over `docker context`.
  docker context use colima-${COLIMA_VM}

  # https://dustinrue.com/2022/10/colima-cpu-architecture-emulation/
  # Using Colima’s built in CPU architecture emulation it is possible to create a Colima profile for either arm64 (aarch64) or amd64 (x86_64)
  # created using: colima --profile vz start --arch aarch64 --vm-type=vz --mount-type=virtiofs --cpu 6 --memory 12
  # https://github.com/lima-vm/lima#how-it-works
  # https://www.infoq.com/news/2022/06/apple-virtualization-framework/

  docker context list # The default context may be based on DOCKER_HOST
  # export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
  # export DOCKER_HOST="unix://${HOME}/.colima/docker.sock"
}

imageArchs(){
  IMGS=$(docker images --format "{{.ID}} {{.Repository}} {{.Tag}}" | while read i r t; do
    echo "$i\t"$(docker image inspect $i |grep "Architecture")"\t$r\t$t"
  done)
  echo $IMGS | grep -v "arm64"
  echo $IMGS | grep "arm64"
}
ds(){
  echo "----- RUNNING CONTAINERS -----"
  docker ps
  echo "----- ALL CONTAINERS -----"
  docker container list -a
  echo "----- VOLUMES -----"
  docker volume list
  if [ "$1" ]; then
     echo "----- IMAGES -----"
     docker images
     imageArchs
  fi
}

