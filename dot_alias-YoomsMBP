_add_bootstrap_func "code"
_bootstrap_code(){
  # https://code.visualstudio.com/docs/editor/command-line#_launching-from-command-line
  local VSCODE_BIN_PATH="/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
  export PATH="$VSCODE_BIN_PATH:$PATH"
}


o(){
  local P="$1"

  if [ -z "$P" ]; then
    P=`pbpaste -Prefer txt`
  fi

  echo "Opening: '$P'" >> ~/open-mac.log
  case $P in
    *dev/labs-* | *labs-decision-support-tool/*)
      code "$P";;
    http://* | https://* | vnc://*)
      open -u "$P";;
    *)
      if [ "$OPENTEXT" ]; then
        open -t "$P"
      elif [ "$OPENFINDER" ]; then
        # Open/Select in Finder
        open -R "$P"
      else
        open "$P" || open -t "$P"
      fi
      ;;
  esac
}
