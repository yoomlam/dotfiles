# Uncomment the following to log timing
# timer=$(($(gdate +%s%N)/1000000))
function __ECHO_TIMER(){
  if [ "$timer" ]; then
    now=$(($(gdate +%s%N)/1000000))
    elapsed=$(($now-$timer))
    echo "$elapsed: \t$1" >&2
    timer=$now
  fi
}

