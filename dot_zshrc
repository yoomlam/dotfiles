### Lazy-initializers

_add_bootstrap_func(){
  # $1 is "app default_arg1 default_arg2"
  local APP=${1%% *}
  # When the app is first run, function _bootstrap_$APP() is run.
  # If args are provided when app is first run, then app is run with the args
  # If no arg is provided when app is first run, then the specified $1 string is run with its default args.
  eval "function $APP(){
    unfunction $APP
    # echo \"(lazy loading: $APP)\"
    _bootstrap_$APP
    if [ \"\$1\" ]; then
      eval $APP \"\$@\"
    else
      eval "$1"
    fi
  }"
}

_add_bootstrap_func "ssh"
_bootstrap_ssh(){
  [ "$SSH_AUTH_SOCK" ] || source $HOME/.ssh/ssh-agent.src

  # check if shell is interactive
  if [[ $- == *i* ]]; then
    if ! ssh-add -l > /dev/null; then
      # add the key specified in `~/.ssh/config`
      # https://docs.github.com/en/authentication/connecting-to-github-with-ssh/generating-a-new-ssh-key-and-adding-it-to-the-ssh-agent#adding-your-ssh-key-to-the-ssh-agent
      ssh-add
    fi
  fi
}

